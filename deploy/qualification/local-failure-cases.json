      "timeout_seconds": 300
    },
    {
      "id": "database-pool-exhaustion-readiness",
      "category": "database",
      "command": ["cargo", "test", "--manifest-path", "api/Cargo.toml", "handlers::health::tests::readiness_fails_within_the_pool_acquire_bound_when_exhausted", "--", "--exact"],
      "timeout_seconds": 300
    },
    {
      "id": "worker-retry-bound",
      "category": "worker",
      "command": ["cargo", "test", "--manifest-path", "api/Cargo.toml", "store::system_jobs::tests::failed_jobs_retry_then_stop_at_the_configured_bound", "--", "--exact"],
      "timeout_seconds": 300
    },
    {
      "id": "audit-restart-reconciliation",
      "category": "audit",
      "command": ["cargo", "test", "--manifest-path", "api/Cargo.toml", "services::audit_actor::tests::durable_enqueue_survives_closed_channel_and_restart_replays_it", "--", "--exact"],
      "timeout_seconds": 300
    },
    {
      "id": "audit-dead-letter-bound",
      "category": "audit",
      "command": ["cargo", "test", "--manifest-path", "api/Cargo.toml", "services::audit_actor::tests::retry_attempts_are_bounded_and_become_observable_dead_letter", "--", "--exact"],
      "timeout_seconds": 300
