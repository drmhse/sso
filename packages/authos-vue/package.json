{
  "name": "@drmhse/authos-vue",
  "version": "0.2.4",
  "description": "Vue and Nuxt adapter for AuthOS authentication",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./nuxt": {
      "import": {
        "types": "./dist/nuxt.d.mts",
        "default": "./dist/nuxt.mjs"
      },
      "require": {
        "types": "./dist/nuxt.d.ts",
        "default": "./dist/nuxt.js"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "vue-tsc --noEmit",
    "lint": "eslint src --ext .ts,.vue",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "authos",
    "auth",
    "authentication",
    "vue",
    "nuxt",
    "oauth",
    "sso"
  ],
  "author": "DRM HSE <info@drmhse.com>",
  "license": "MIT",
  "peerDependencies": {
    "vue": ">=3.4.0"
  },
  "devDependencies": {
    "@types/node": "^25.0.3",
    "nuxt": "^3.14.0",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vue": "^3.5.13",
    "vue-tsc": "^2.2.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/drmhse/AuthOS.git",
    "directory": "packages/authos-vue"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@drmhse/sso-sdk": "*"
  }
}
