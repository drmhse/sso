{
  "name": "@drmhse/authos-node",
  "version": "0.1.6",
  "description": "Node.js server adapter for AuthOS authentication - Express middleware and token verification",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./express": {
      "import": {
        "types": "./dist/express.d.mts",
        "default": "./dist/express.mjs"
      },
      "require": {
        "types": "./dist/express.d.ts",
        "default": "./dist/express.js"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "authos",
    "auth",
    "authentication",
    "node",
    "express",
    "middleware",
    "jwt",
    "jwks"
  ],
  "author": "DRM HSE <info@drmhse.com>",
  "license": "MIT",
  "peerDependencies": {
    "express": ">=4.0.0"
  },
  "peerDependenciesMeta": {
    "express": {
      "optional": true
    }
  },
  "dependencies": {
    "@drmhse/sso-sdk": "*"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.2",
    "express": "^4.21.2",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/drmhse/AuthOS.git",
    "directory": "packages/authos-node"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
