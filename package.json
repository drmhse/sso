{
  "name": "authos-public",
  "version": "0.0.0",
  "description": "Public AuthOS API, TypeScript SDK, and framework packages",
  "private": true,
  "workspaces": [
    "sso-sdk",
    "lite-web-client",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces",
    "check:trust": "node scripts/check-trust-metadata.mjs",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lite-web:build": "npm run build -w lite-web-client",
    "build:sdk": "npm run build -w @drmhse/sso-sdk",
    "build:packages": "npm run build -w @drmhse/authos-react -w @drmhse/authos-vue -w @drmhse/authos-node -w @drmhse/authos-cli",
    "typecheck:sdk": "npm run typecheck -w @drmhse/sso-sdk",
    "typecheck:packages": "npm run typecheck -w @drmhse/authos-react -w @drmhse/authos-vue -w @drmhse/authos-node -w @drmhse/authos-cli",
    "authos:binary": "node scripts/authos-bootstrap/build-binary.js",
    "authos:docker:dist": "node scripts/authos-bootstrap/prepare-docker-dist.js"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/drmhse/AuthOS.git"
  },
  "keywords": [
    "authos",
    "sso",
    "oauth",
    "authentication",
    "multi-tenant"
  ],
  "author": "DRM HSE <info@drmhse.com>",
  "license": "SEE LICENSE IN LICENSE",
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24.0.0"
  },
  "overrides": {
    "postcss": "^8.5.10",
    "shell-quote": "1.8.4",
    "tsup": {
      "esbuild": "0.28.1"
    },
    "vite": {
      "esbuild": "0.28.1"
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@typescript-eslint/eslint-plugin": "^8.64.0",
    "@typescript-eslint/parser": "^8.64.0",
    "esbuild": "0.28.1",
    "eslint": "^10.7.0",
    "eslint-plugin-vue": "^10.9.2",
    "globals": "^17.7.0",
    "vite": "8.0.16",
    "vue-eslint-parser": "^10.4.1"
  }
}
