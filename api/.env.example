# ============================================================================
# Multi-tenant SSO Platform - Environment Configuration
# ============================================================================
#
# This file documents all available environment variables.
# Copy this file to `.env` and update with your actual values.
#
# Quick Start:
#   1. Copy: cp .env.example .env
#   2. Generate JWT keys (see JWT Configuration section below)
#   3. Generate encryption key (see Encryption section below)
#   4. Configure at least one OAuth provider
#   5. Configure SMTP for email delivery
#
# ============================================================================
# Database Configuration
# ============================================================================
#
# IMPORTANT: DATABASE_URL must match the database backend you're using
#
# Native builds (choose one):
#   - SQLite:     cargo build --release --no-default-features --features db_sqlite (default)
#   - PostgreSQL: cargo build --release --no-default-features --features db_psql
#   - MySQL:      cargo build --release --no-default-features --features db_mysql
#
# Docker Compose (using profiles):
#   - SQLite:     docker-compose up                      # default
#   - PostgreSQL: docker-compose --profile postgres up
#   - MySQL:      docker-compose --profile mysql up
#
# See docs/content/api/deployment-guide.md for complete deployment instructions

# SQLite (default) - Best for single-server deployments
DATABASE_URL=sqlite:./data/data.db

# PostgreSQL - Best for multi-server and high-availability deployments
# DATABASE_URL=postgres://username:password@localhost:5432/sso

# MySQL - Best for existing MySQL infrastructure
# DATABASE_URL=mysql://username:password@localhost:3306/sso

# ============================================================================
# Logging
# ============================================================================

# Rust logging level (error, warn, info, debug, trace)
RUST_LOG=info

# ============================================================================
# JWT Configuration (RS256 Asymmetric Signing)
# ============================================================================
#
# Generate RSA key pair:
#   openssl genrsa -out private.pem 2048
#   openssl rsa -in private.pem -pubout -out public.pem
#
# Base64 encode for environment variables:
#   base64 -i private.pem | tr -d '\n'
#   base64 -i public.pem | tr -d '\n'
#
# Key ID should be unique (e.g., production-key-1, staging-key-1)

JWT_PRIVATE_KEY_BASE64=your-base64-encoded-rsa-private-key
JWT_PUBLIC_KEY_BASE64=your-base64-encoded-rsa-public-key
JWT_KID=your-unique-key-id
JWT_EXPIRATION_HOURS=24

# ============================================================================
# Platform OAuth (Admin Authentication)
# ============================================================================
#
# These credentials are used for platform owners and organization admins
# to authenticate and access the admin dashboard. Configure at least one.
#
# OAuth Application Setup:
#   GitHub:    https://github.com/settings/developers
#   Google:    https://console.cloud.google.com/apis/credentials
#   Microsoft: https://portal.azure.com/#blade/Microsoft_AAD_RegisteredApps

# GitHub OAuth
PLATFORM_GITHUB_CLIENT_ID=your-platform-admin-github-client-id
PLATFORM_GITHUB_CLIENT_SECRET=your-platform-admin-github-client-secret
PLATFORM_GITHUB_REDIRECT_URI=http://localhost:3001/auth/admin/github/callback

# Google OAuth
PLATFORM_GOOGLE_CLIENT_ID=your-platform-admin-google-client-id
PLATFORM_GOOGLE_CLIENT_SECRET=your-platform-admin-google-client-secret
PLATFORM_GOOGLE_REDIRECT_URI=http://localhost:3001/auth/admin/google/callback

# Microsoft OAuth
PLATFORM_MICROSOFT_CLIENT_ID=your-platform-admin-microsoft-client-id
PLATFORM_MICROSOFT_CLIENT_SECRET=your-platform-admin-microsoft-client-secret
PLATFORM_MICROSOFT_REDIRECT_URI=http://localhost:3001/auth/admin/microsoft/callback

# ============================================================================
# Custom OAuth URLs (Optional - for testing/mocking)
# ============================================================================
#
# Override default OAuth provider URLs for testing with mock servers.
# Leave commented out for production (uses real OAuth providers).
#
# Used by integration tests with mock OAuth server.

# GitHub Custom URLs
# PLATFORM_GITHUB_AUTH_URL=http://localhost:9000/mock-oauth/github/authorize
# PLATFORM_GITHUB_TOKEN_URL=http://localhost:9000/mock-oauth/github/token
# PLATFORM_GITHUB_USER_API_URL=http://localhost:9000/mock-api/github/user

# Google Custom URLs
# PLATFORM_GOOGLE_AUTH_URL=http://localhost:9000/mock-oauth/google/authorize
# PLATFORM_GOOGLE_TOKEN_URL=http://localhost:9000/mock-oauth/google/token
# PLATFORM_GOOGLE_USER_API_URL=http://localhost:9000/mock-api/google/userinfo

# Microsoft Custom URLs
# PLATFORM_MICROSOFT_AUTH_URL=http://localhost:9000/mock-oauth/microsoft/authorize
# PLATFORM_MICROSOFT_TOKEN_URL=http://localhost:9000/mock-oauth/microsoft/token
# PLATFORM_MICROSOFT_USER_API_URL=http://localhost:9000/mock-api/microsoft/me

# ============================================================================
# Billing Provider Configuration
# ============================================================================
#
# Choose your billing provider: "stripe" or "polar"
# Default: stripe (if not specified)
#
BILLING_PROVIDER=stripe

# ============================================================================
# Stripe Payment Integration
# ============================================================================
#
# Required when using Stripe as your billing provider.
# Get your keys from: https://dashboard.stripe.com/apikeys
#
# Webhook Secret: Create webhook at https://dashboard.stripe.com/webhooks
# Point to: https://your-domain.com/api/webhooks/billing
#
STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key
STRIPE_WEBHOOK_SECRET=whsec_your-stripe-webhook-secret

# Optional: Override Stripe API base URL (for testing with mock server)
# STRIPE_API_BASE_URL=http://localhost:9000/mock-stripe/v1

# Optional: Enable test mode to bypass webhook signature verification (TESTING ONLY)
# STRIPE_WEBHOOK_TEST_MODE=true

# ============================================================================
# Polar Payment Integration (Alternative to Stripe)
# ============================================================================
#
# Required when using Polar as your billing provider.
# Get your keys from: https://polar.sh/dashboard/settings/api
#
# Webhook Secret: Configure webhook at https://polar.sh/dashboard/settings/webhooks
# Point to: https://your-domain.com/api/webhooks/billing
# Format: Standard Webhooks (Svix-compatible)
#
# POLAR_API_KEY=polar_xxxxx
# POLAR_WEBHOOK_SECRET=whsec_xxxxx

# Optional: Override Polar API base URL (for testing with mock server)
# POLAR_API_BASE_URL=http://localhost:9000/mock-polar/v1

# ============================================================================
# SMTP/Email Configuration
# ============================================================================
#
# Required for sending emails (verification, password reset, invitations).
#
# Production options:
#   - SendGrid: smtp.sendgrid.net:587
#   - Mailgun:  smtp.mailgun.org:587
#   - AWS SES:  email-smtp.region.amazonaws.com:587
#   - Gmail:    smtp.gmail.com:587 (use app password)
#
# Development options:
#   - Mailpit:  localhost:1025 (docker-compose.dev.yml)
#   - Mailtrap: smtp.mailtrap.io:2525

SMTP_HOST=smtp.your-provider.com
SMTP_PORT=587

# Optional: Leave empty for dev SMTP servers that don't require auth (e.g., Mailpit)
SMTP_USERNAME=your-smtp-username
SMTP_PASSWORD=your-smtp-password

# Email "From" address and display name
SMTP_FROM_EMAIL=noreply@your-domain.com
SMTP_FROM_NAME=SSO Platform

# ============================================================================
# Server Configuration
# ============================================================================

# Host to bind the server to (0.0.0.0 = all interfaces)
SERVER_HOST=0.0.0.0

# Port to listen on
SERVER_PORT=3001

# Public base URL of your API (no trailing slash)
BASE_URL=http://localhost:3001

# Base URL for the platform dashboard/web client
PLATFORM_DASHBOARD_BASE_URL=http://localhost:4000

# Proxy header trust is disabled by default. Enable only when the API is behind
# a trusted reverse proxy that overwrites client-supplied forwarding headers.
# TRUST_PROXY_HEADERS=false
# TRUSTED_PROXY_IPS=203.0.113.10,2001:db8::10

# ============================================================================
# Platform Owner Configuration
# ============================================================================
#
# The platform owner is the super admin who manages all organizations.
# On first startup, if these are set, a platform owner account is created.

PLATFORM_OWNER_EMAIL=admin@example.com

# Optional: Password for platform owner (hashed on startup)
# Enables password-based login for initial setup without configuring OAuth.
# After first login, you can use OAuth and remove this.
PLATFORM_OWNER_PASSWORD=your-secure-password

# ============================================================================
# Security & Encryption
# ============================================================================

# Encryption key for BYOO credentials (32-byte hex, 64 characters)
# Generate with: openssl rand -hex 32
ENCRYPTION_KEY=your-64-character-hex-encryption-key

# Optional: Disable rate limiting (useful for development/testing)
# DISABLE_RATE_LIMITING=true

# ============================================================================
# Optional Features
# ============================================================================

# GeoIP Location Services (enables impossible travel detection & geo-risk analysis)
#
# The GeoIP database is automatically downloaded on first container start if you provide
# a MaxMind license key. Get a free key at: https://www.maxmind.com/en/geolite2/signup
#
# MAXMIND_LICENSE_KEY=your-maxmind-license-key
#
# Advanced configuration:
# GEOIP_DATABASE_PATH=/app/geoip/GeoLite2-City.mmdb  # Path to database file (default shown)
# GEOIP_DISABLED=false  # Set to true to disable GeoIP features entirely

# Device Trust Secret (for device fingerprinting and risk analysis)
# Generate with: openssl rand -hex 32
# DEVICE_TRUST_SECRET=your-64-character-hex-device-trust-secret

# ============================================================================
# Background Job Processing
# ============================================================================

# Job processor interval in seconds (default: 10)
# This controls how often background jobs run (email sending, webhooks, etc.)
# Lower values = faster email delivery, higher CPU usage
# Production: 10 (recommended)
# Development: 5 (faster feedback)
# Testing: 1 (instant for integration tests)
# JOB_PROCESSOR_INTERVAL_SECS=10
